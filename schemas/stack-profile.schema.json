{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VibeUnion Stack Profile",
  "type": "object",
  "required": ["id", "name", "targets", "stack", "allowed", "forbidden", "backend", "verification"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "targets": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "stack": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "allowed": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "forbidden": { "type": "array", "items": { "type": "string" } },
    "backend": {
      "type": "object",
      "required": ["local", "production", "client"],
      "properties": {
        "local": { "type": "string" },
        "production": { "type": "string" },
        "client": { "type": "string" }
      }
    },
    "verification": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    }
  }
}
